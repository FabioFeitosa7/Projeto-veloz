# Copie este arquivo para .env quando a configuração por ambiente for adicionada.
# Nunca coloque valores secretos reais neste arquivo de exemplo.

DJANGO_SECRET_KEY=gere-uma-chave-longa-aleatoria-e-exclusiva
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Endereços completos do frontend, separados por vírgula e sem caminhos.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Deixe vazio para usar SQLite. Em produção, use a URI PostgreSQL completa.
DATABASE_URL=

# Proteções da API pública. Em produção no Render, há normalmente um proxy.
API_RATE_LEITURA=300/min
API_RATE_ESCRITA=60/min
API_NUM_PROXIES=0
DJANGO_MAX_REQUEST_BYTES=1048576
DJANGO_MAX_REQUEST_FIELDS=1000
